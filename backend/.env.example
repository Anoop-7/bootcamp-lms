# Application Environment
NODE_ENV=development
PORT=5000
TRUST_PROXY=0

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Database & Security
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bootcamp?schema=public
JWT_SECRET=replace_with_a_secure_minimum_32_char_secret_key

# AWS S3 Storage & Transcoder
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# CloudFront HLS Private Streaming
CLOUDFRONT_DOMAIN=https://dxxxxxxxxxxxx.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=KXXXXXXXXXXXXX
CLOUDFRONT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Payments (off | mock | razorpay)
PAYMENTS_MODE=off
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMTP Mailer (Optional in development)
SMTP_USER=
SMTP_PASS=

# Razorpay Test / Live Credentials
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
PAYMENTS_MODE="razorpay"